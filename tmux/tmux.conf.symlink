set-option -g status-position top
set-option -g status-justify centre

# Use same prefix as gnuscreen
set-option -g prefix C-a
unbind-key C-b
bind-key C-a send-prefix

# Enable mouse
set -g mouse on

# I not sure why would need to wait for Esc, and it interferes with vim
set-option -sg escape-time 0

# History
set -g history-limit 10000

# Resize to smallest viewing client, not smallest attached client.
set -g aggressive-resize on

# Colours
set-option -g default-terminal "screen-256color"
col_yellow=3
col_orange=9
col_red=1
col_magenta=5
col_violet=13
col_blue=4
col_cyan=6
col_green=2

col_bg="0"
col_bg_hl="0"
col_secondary="8"
col_primary="7"
col_optional_em="15"
col_host="12"


# Left status is session name, right is hostname + date. Highlights current
# window name.
set-option -g status-style "bg=colour$col_bg,fg=colour$col_primary"
set-option -g status-left "#[fg=colour$col_secondary]#[bg=colour$col_bg_hl] #S"
set-option -g status-right ""

set-option -g window-status-style "fg=colour$col_secondary"
set-option -g window-status-current-style "reverse,fg=colour$col_host"
set-option -g automatic-rename on
set-option -g automatic-rename-format '#($DOTFILES/tmux/tmux-window-name.sh "#{pane_current_path}")'
set-option -g window-status-format "#{?#{e|>:#{session_windows},1}, #I:#W#{?window_zoomed_flag,Z,} ,}"
set-option -g window-status-current-format "#{?#{e|>:#{session_windows},1}, #I:#W#{?window_zoomed_flag,Z,} ,}"

# Command bar colours
set-option -g message-command-style "bg=colour$col_orange,fg=colour$col_bg_hl"
set-option -g message-style "bg=colour$col_bg_hl,fg=colour$col_primary"

# Highlight current pane.
set-option -g pane-active-border-style "fg=colour$col_optional_em"
set-option -g pane-border-style "fg=colour$col_secondary"
set-option -g pane-border-indicators colour
set-option -g pane-border-lines heavy

# The leftmost key should show the leftmost window.
set-option -g base-index 1
set-option -g pane-base-index 1

# vi
set-option -g status-keys vi
set-option -g mode-keys vi
bind h run-shell '$DOTFILES/tmux/tmux-nested-move.sh L'
bind j run-shell '$DOTFILES/tmux/tmux-nested-move.sh D'
bind k run-shell '$DOTFILES/tmux/tmux-nested-move.sh U'
bind l run-shell '$DOTFILES/tmux/tmux-nested-move.sh R'
bind-key -T copy-mode-vi 'v' send -X begin-selection

# Splitscreen
bind r swap-pane -D
bind R swap-pane -U
bind -r C-h resize-pane -L 5
bind -r C-j resize-pane -D 5
bind -r C-k resize-pane -U 5
bind -r C-l resize-pane -R 5
bind H select-layout main-vertical
bind J select-layout even-vertical
bind K select-layout main-horizontal
bind L select-layout even-horizontal
bind Space select-layout tiled
bind - select-layout -o  # Undo last layout change
bind-key Q setw synchronize-panes \; display-message "toggled pane sync"
bind X confirm-before -p "kill-window #W? (y/n)" kill-window
bind z resize-pane -Z  # Zoom: always operates on current (inner) session
bind o run-shell '                                                      \
  outer=$(tmux show-environment MD_TMUX_OUTER 2>/dev/null |             \
          sed "s/^MD_TMUX_OUTER=//");                                   \
  if [ -n "$outer" ] && ! echo "$outer" | grep -q "^-"; then           \
    tmux resize-pane -Z -t "$outer";                                    \
  else                                                                  \
    tmux resize-pane -Z;                                                \
    session=$(tmux display-message -p "#{session_name}");               \
    pane=$(tmux display-message -p "#{pane_id}");                       \
    nested=$(tmux display-message -t "$pane" -p "#{@nested}");          \
    if [ "$nested" = "on" ]; then                                       \
      cmd=$(tmux display-message -t "$pane" -p "#{pane_current_command}"); \
      if [ "$cmd" = "tmux" ]; then                                      \
        state=$(tmux show -t "$session" -qv @passthrough 2>/dev/null);  \
        if [ "$state" != "on" ]; then                                   \
          "$DOTFILES/tmux/tmux-toggle-nested.sh" "$session";            \
        fi;                                                             \
      fi;                                                               \
    fi;                                                                 \
  fi'
bind O run-shell '                                                    \
  cur=$(tmux display -p "#{pane_height}");                            \
  win=$(tmux display -p "#{window_height}");                          \
  target=$((win * 60 / 100));                                         \
  if [ "$cur" -lt "$target" ]; then                                   \
    tmux set-option -p @halfzoom_prev "$cur";                         \
    tmux resize-pane -y 60%;                                          \
  else                                                                \
    prev=$(tmux show-options -pqv @halfzoom_prev);                    \
    if [ -n "$prev" ]; then                                           \
      tmux resize-pane -y "$prev";                                    \
    fi;                                                               \
  fi                                                                  \
'

# Use namespace shell wrapper to enable pbcopy and pbpaste commands on OS X.
set-option -g default-command "if command -v reattach-to-user-namespace >/dev/null; then reattach-to-user-namespace -l bash; else bash; fi"

# Tmux 1.8 has copy-pipe command, which copies selected text to the tmux paste
# buffer and pipes it to given command
bind-key -T copy-mode-vi 'y' send -X copy-pipe \
    "if command -v reattach-to-user-namespace >/dev/null; \
    then reattach-to-user-namespace pbcopy; \
    elif command -v xclip >/dev/null; \
    then xclip -selection clipboard; fi"

# Do the same for the default copy binding of Enter
unbind -T copy-mode-vi Enter
bind-key -T copy-mode-vi Enter send -X copy-pipe "if command -v reattach-to-user-namespace >/dev/null; then reattach-to-user-namespace pbcopy; elif command -v xclip >/dev/null; then xclip -selection clipboard; fi"

# Shortcut for running the fzf goto command
bind-key -r "C-p" new-window -n "goto" 'source "$DOTFILES/tmux/tmux_env.dot.sh" && ,tm-goto'

bind-key -r "C-c" new-window -c "#{pane_current_path}" ",fzf --action copy"
bind-key -r "C-v" new-window -c "#{pane_current_path}" ",fzf --action send-keys-last-window"

# Workaround for claude code not knowing when focus changes. All other
# programs seem to get xterm events and respond accordingly. This
# setting at least gives us coverage for tmux pane switches.
set-option -g focus-events on

# Nested session support: when launched via ,tmux, MD_TMUX_OUTER
# is set to the outer session name. C-a a toggles the outer session's
# prefix on/off so keys pass through to the inner session.
bind a run-shell '$DOTFILES/tmux/tmux-toggle-nested.sh'
# Clear stale hooks from previous config reloads (source-file doesn't remove hooks)
set-hook -gu after-select-pane
set-hook -gu client-focus-in
set-hook -g client-focus-in 'run-shell -b "$DOTFILES/tmux/tmux-nested-focus.sh \"#{session_name}\" \"#{pane_id}\""'
bind -n MouseDown1Pane select-pane -t= \; run-shell -b "$DOTFILES/tmux/tmux-nested-focus.sh '#{session_name}' '#{pane_id}'"